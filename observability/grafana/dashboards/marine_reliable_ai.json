      "id": 1,
      "title": "Queued jobs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "marine-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "marine_ingestion_jobs{status=\"queued\"}",
          "refId": "A",
          "legendFormat": "Queued jobs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
