    {
      "id": 7,
      "title": "Requests/sec by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "marine-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (route,method) (rate(marine_http_requests_total[1m]))",
          "refId": "A",
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
